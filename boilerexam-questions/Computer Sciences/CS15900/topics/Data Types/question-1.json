      "type": "CODE",
      "data": {
        "content": "#include <stdio.h>\n\n#define PI 3.14159\n#define SPHERE 4 / 3\n\nint main(void)\n{\n  int radius = 2;\n  int circ;\n  int volume;\n  float surfaceArea;\n\n  circ = 2 * PI * radius * radius;\n  volume = SPHERE * (int)PI * radius * radius;\n  surfaceArea = PI * radius * radius * SPHERE * 3;\n\n  printf(\"-=-=-=-=-=-=-=-=-=-=-\\n\");\n  printf(\"circumference:%-5dunits\\n\", circ);\n  printf(\"-=-=-=-=-=-=-=-=-=-=-\\n\");\n  printf(\"volume: %10.2f\\n\", (float) volume);\n  printf(\"-=-=-=-=-=-=-=-=-=-=-\\n\");\n  printf(\"surface area: %.1f\\n\", surfaceArea);\n  printf(\"-=-=-=-=-=-=-=-=-=-=-\\n\");\n\n  return(0);\n}",
        "language": "C"
