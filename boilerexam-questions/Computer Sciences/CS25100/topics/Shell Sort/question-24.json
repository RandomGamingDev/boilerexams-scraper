      "id": "afd9e918-94e2-495d-9632-a098670cb8e4",
      "type": "CODE",
      "data": {
        "content": "Algorithm ShellSort(A, H)\n   Let n = |A|\n   Let m = |H|\n   for (h = 0, h < m, 1)\n      Let gap = H[h]\n      for (i = 1, i < n, 1) \n         j = i - 1\n         while (j >= 0 && j + gap < n && A[j] < A[j + gap]) \n            swap(A, j, j + gap)\n            j -= gap\n         end while\n      end for\n   end for\n   return A\nEnd Algorithm\n",
        "language": "TEXT"
      },
