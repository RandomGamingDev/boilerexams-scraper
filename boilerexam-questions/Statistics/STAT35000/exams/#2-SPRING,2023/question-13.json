            "stats": {
              "count": 0
            },
            "resources": []
          },
          {
            "id": "588e5ab8-c724-4f87-ba51-1c97ec66171d",
            "index": 1,
            "body": "Two-sample independent",
            "questionId": "92887cfb-5210-4e22-beba-536611273d69",
            "stats": {
              "count": 0
            },
            "resources": []
          },
          {
            "id": "b212741d-2649-4865-a949-bf8ee685cf1f",
