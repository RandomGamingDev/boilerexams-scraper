{
  "id": "1db354cd-c4bf-4498-8cf6-ae5ba9aabc1c",
  "type": "MULTIPLE_CHOICE",
  "data": {
    "body": "Which of the following statements is FALSE?",
    "solution": [
      4
    ],
    "answerChoices": [
      {
        "id": "52e0f486-aed8-46b2-a5d0-597be68087dc",
        "index": 0,
        "body": "If the set $\\{\\mathbf{u}, \\mathbf{v}, \\mathbf{w}\\}$ is orthonormal, then the set $\\{\\mathbf{u}+\\mathbf{v}, \\mathbf{u}-\\mathbf{v}, \\mathbf{w}\\}$ is orthogonal.",
        "questionId": "1db354cd-c4bf-4498-8cf6-ae5ba9aabc1c",
        "stats": {
          "count": 512
        },
        "resources": []
      },
      {
        "id": "8e643ed0-4b56-4869-8cf3-a65c39837a2b",
        "index": 1,
        "body": "If a matrix $A$ has orthogonal columns, then $A^{T} A$ is a diagonal matrix.",
        "questionId": "1db354cd-c4bf-4498-8cf6-ae5ba9aabc1c",
        "stats": {
          "count": 320
        },
        "resources": []
      },
      {
        "id": "201b6acd-732e-46cf-a53f-f36b4fde5f28",
        "index": 2,
        "body": "Orthogonal matrices are invertible.",
        "questionId": "1db354cd-c4bf-4498-8cf6-ae5ba9aabc1c",
        "stats": {
          "count": 429
        },
        "resources": []
      },
      {
        "id": "992b6477-fdf6-4540-9201-78489846132b",
        "index": 3,
        "body": "For vectors $\\mathbf{u}$ and $\\mathbf{v}$, if $\\|\\mathbf{u}-\\mathbf{v}\\|^{2}=\\|\\mathbf{u}\\|^{2}+\\|\\mathbf{v}\\|^{2}$, then $\\mathbf{u}$ and $\\mathbf{v}$ are orthogonal.",
        "questionId": "1db354cd-c4bf-4498-8cf6-ae5ba9aabc1c",
        "stats": {
          "count": 398
        },
        "resources": []
      },
      {
        "id": "1bce5367-06cc-40bf-87f4-9c89d982e9fe",
        "index": 4,
        "body": "Performing the Gram-Schmidt process on the set $\\left\\{\\mathbf{v}_{1}, \\mathbf{v}_{2}\\right\\}$ and the set $\\left\\{\\mathbf{v}_{2}, \\mathbf{v}_{1}\\right\\}$ always gives the identical orthonormal basis for the $\\operatorname{Span}\\left\\{\\mathbf{v}_{1}, \\mathbf{v}_{2}\\right\\}$.",
        "questionId": "1db354cd-c4bf-4498-8cf6-ae5ba9aabc1c",
        "stats": {
          "count": 2106
        },
        "resources": []
      }
    ]
